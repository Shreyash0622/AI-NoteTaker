generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("pending")
  transcript String?
  notes     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
