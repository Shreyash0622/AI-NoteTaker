{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["api/**/*.ts", "workers/**/*.ts", "db/**/*.ts", "prompts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
