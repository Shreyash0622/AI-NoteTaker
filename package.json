{
  "name": "ai-note-taker-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API and workers for an AI meeting-notes app",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch api/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "worker": "tsx workers/meeting-notes.worker.ts",
    "worker:build": "node dist/workers/meeting-notes.worker.js",
    "db:generate": "prisma generate --schema=db/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=db/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=db/schema.prisma",
    "db:studio": "prisma studio --schema=db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "bullmq": "^6.2.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "multer": "^2.2.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.2.0",
    "prisma": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
